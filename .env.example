# ---------------------------------------------------------------------------
# LedgerLens — copy to .env (never commit real credentials)
# ---------------------------------------------------------------------------
NODE_ENV=development

# API server
PORT=4000
CLIENT_URL=http://localhost:5173
# Comma-separated extra origins allowed by CORS
# CORS_ORIGINS=https://your-frontend.example

# Persistence: sqlite (zero-config file-backed demo store) or mongodb
PERSISTENCE=sqlite
SQLITE_PATH=./data/ledgerlens-demo.db
# Required only when PERSISTENCE=mongodb
# MONGODB_URI=mongodb://127.0.0.1:27017/ledgerlens

# Local demo provider. Demo actions are disabled when DEMO_MODE=false.
DEMO_MODE=true
DEMO_SEED=true

# Payment provider adapter: demo or razorpay
PAYMENT_PROVIDER=demo
RAZORPAY_ENVIRONMENT=sandbox
# Required for the real Razorpay webhook adapter. Signature verification is
# never skipped when this is absent — the endpoint returns 503 instead.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Observability / limits
LOG_LEVEL=info
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
TRUST_PROXY=0
